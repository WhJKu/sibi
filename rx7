<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Script Listesi ve Arama</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
            background-color: #1e1e1e;
            color: #ffffff;
        }

        /* Arama Kutusu Stili */
        .search-container {
            margin-bottom: 20px;
            font-weight: bold;
        }

        .search-container input {
            padding: 8px;
            width: 300px;
            background-color: #2d2d2d;
            border: 1px solid #444;
            color: #fff;
            border-radius: 4px;
            outline: none;
        }

        .search-container input:focus {
            border-color: #007bff;
        }

        /* Liste Öğesi */
        .list-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #2d2d2d;
            padding: 10px 15px;
            margin: 8px 0;
            border-radius: 5px;
            border: 1px solid #444;
            max-width: 700px;
        }

        .item-name {
            font-weight: bold;
            color: #ff5555;
        }

        button {
            padding: 6px 12px;
            cursor: pointer;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            font-weight: bold;
        }

        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>

    <!-- 1- Search Alanı (Tıklanınca otomatik yazı yazılabilir) -->
    <div class="search-container">
        <input type="text" id="searchInput" placeholder="Search (Arama yapmak için yazın)..." onkeyup="filterItems()">
    </div>

    <hr style="border-color: #444; max-width: 700px; margin-left: 0;">

    <!-- Liste -->
    <div id="scriptList">
        <!-- LAGGER Öğesi -->
        <div class="list-item" data-name="LAGGER">
            <span class="item-name">LAGGER</span>
            <button onclick="copyCode('loadstring(game:HttpGet(\'https://raw.githubusercontent.com/LexionBB/SWX/refs/heads/main/SWXLagger\'))()')">Copy</button>
        </div>

        <!-- İleride başka scriptler eklemek istersen diye örnek: -->
        <div class="list-item" data-name="Örnek Script 2">
            <span class="item-name">Örnek Script 2</span>
            <button onclick="copyCode('print(\'Örnek 2\')')">Copy</button>
        </div>
    </div>

    <script>
        // Arama Filtreleme Fonksiyonu (İsminde ne geçerse çıksın, büyük/küçük harf duyarsız)
        function filterItems() {
            let input = document.getElementById('searchInput').value.toLowerCase();
            let items = document.getElementsByClassName('list-item');

            for (let i = 0; i < items.length; i++) {
                let name = items[i].getAttribute('data-name').toLowerCase();
                if (name.includes(input)) {
                    items[i].style.display = "flex"; // Eşleşiyorsa göster
                } else {
                    items[i].style.display = "none";  // Eşleşmiyorsa gizle
                }
            }
        }

        // Kopyalama Fonksiyonu
        function copyCode(code) {
            navigator.clipboard.writeText(code).then(() => {
                alert('Script Kopyalandı!');
            }).catch(err => {
                console.error('Kopyalama hatası: ', err);
            });
        }
    </script>

</body>
</html>
