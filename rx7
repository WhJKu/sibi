<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LW HUB SCRIPTS</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #121212;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Ana Kutu (Container) */
        .main-container {
            background-color: #313131;
            width: 450px;
            padding: 30px 25px;
            border-radius: 35px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Başlık */
        .title {
            color: #ffffff;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 25px;
            text-align: center;
        }

        /* Arama Alanı */
        .search-box {
            position: relative;
            width: 100%;
            margin-bottom: 30px;
        }

        .search-box input {
            width: 100%;
            background-color: #8c8c8c;
            border: none;
            padding: 12px 15px 12px 45px;
            border-radius: 6px;
            color: #ffffff;
            font-size: 16px;
            font-weight: bold;
            outline: none;
        }

        .search-box input::placeholder {
            color: #ffffff;
            letter-spacing: 1px;
        }

        .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            border: 2px solid #ffffff;
            border-radius: 50%;
        }

        .search-icon::after {
            content: '';
            position: absolute;
            width: 2px;
            height: 8px;
            background-color: #ffffff;
            bottom: -6px;
            right: -4px;
            transform: rotate(-45deg);
        }

        /* Script Kartı */
        .script-list {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .script-card {
            background-color: #1a1a1a;
            border-radius: 12px;
            padding: 12px 15px;
            width: 100%;
            position: relative;
        }

        .script-title {
            color: #8c8c8c;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .script-content-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .script-code {
            color: #b0b0b0;
            font-size: 11px;
            font-family: monospace;
            word-break: break-all;
            padding-right: 15px;
            line-height: 1.3;
        }

        .copy-btn {
            background: none;
            border: none;
            color: #ffffff;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            padding-left: 15px;
            border-left: 1px solid #555;
            height: 35px;
            display: flex;
            align-items: center;
            transition: color 0.2s;
        }

        .copy-btn:hover {
            color: #00ffcc;
        }
    </style>
</head>
<body>

    <div class="main-container">
        <!-- Başlık -->
        <div class="title">LW HUB SCRIPTS</div>

        <!-- Arama Çubuğu -->
        <div class="search-box">
            <div class="search-icon"></div>
            <input type="text" id="searchInput" placeholder="SEARCH" onkeyup="filterScripts()">
        </div>

        <!-- Script Listesi -->
        <div class="script-list" id="scriptList">
            
            <!-- LAGGER Öğesi -->
            <div class="script-card" data-name="LAGGER">
                <div class="script-title">LAGGER</div>
                <div class="script-content-area">
                    <div class="script-code">loadstring(game:HttpGet('https://raw.githubusercontent.com/LexionBB/SWX/refs/heads/main/SWXLagger'))()</div>
                    <button class="copy-btn" onclick="copyCode(this, 'loadstring(game:HttpGet(\'https://raw.githubusercontent.com/LexionBB/SWX/refs/heads/main/SWXLagger\'))()')">copy</button>
                </div>
            </div>

            <!-- İstediğin kadar bu kalıpla çoğaltabilirsin -->

        </div>
    </div>

    <script>
        // Arama (Filtreleme) Fonksiyonu
        function filterScripts() {
            let input = document.getElementById('searchInput').value.toLowerCase();
            let cards = document.getElementsByClassName('script-card');

            for (let i = 0; i < cards.length; i++) {
                let name = cards[i].getAttribute('data-name').toLowerCase();
                if (name.includes(input)) {
                    cards[i].style.display = "block";
                } else {
                    cards[i].style.display = "none";
                }
            }
        }

        // Kopyalama Fonksiyonu ve Görsel Geri Bildirim
        function copyCode(buttonElement, code) {
            navigator.clipboard.writeText(code).then(() => {
                let originalText = buttonElement.innerText;
                buttonElement.innerText = "copied!";
                buttonElement.style.color = "#00ffcc";
                
                setTimeout(() => {
                    buttonElement.innerText = originalText;
                    buttonElement.style.color = "#ffffff";
                }, 1500);
            }).catch(err => {
                console.error('Kopyalama hatası: ', err);
            });
        }
    </script>

</body>
</html>
